/* 记录卡片组件样式 */

.record-card {
  transition: background 0.2s;
}

.record-card:active {
  background: #f7f8fa;
}

.header {
  margin-bottom: 16rpx;
}

.time-text {
  font-size: 24rpx;
  color: #969799;
}

.item-line {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-line:last-child {
  border-bottom: none;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #323233;
}

.item-count {
  margin: 0 30rpx;
  font-size: 26rpx;
  color: #969799;
}

.item-price {
  font-size: 26rpx;
  color: #ee0a24;
  font-weight: 500;
}

.memo {
  margin-top: 12rpx;
  padding: 12rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
