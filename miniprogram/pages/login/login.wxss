.container { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30px; background: linear-gradient(180deg, #e8f4ff 0%, #f5f5f5 60%); }
.logo-area { display: flex; flex-direction: column; align-items: center; margin-bottom: 50px; }
.logo-img { width: 72px; height: 72px; border-radius: 16px; }
.app-name { font-size: 22px; font-weight: 700; color: #333; margin-top: 16px; }
.app-desc { font-size: 13px; color: #999; margin-top: 6px; }
.login-area { width: 100%; max-width: 320px; }
.login-tip { text-align: center; font-size: 12px; color: #ccc; margin-top: 12px; }
