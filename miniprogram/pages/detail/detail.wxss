.container { min-height: 100vh; padding-bottom: 120px; background: #f5f5f5; }
.card { background: #fff; margin: 6px 10px; border-radius: 10px; padding: 10px 14px; }
.card-title { font-size: 13px; font-weight: 600; color: #333; margin-bottom: 6px; padding-bottom: 6px; border-bottom: 1px solid #f0f0f0; }

.compact-row { display: flex; justify-content: space-between; padding: 4px 0; }
.compact-label { font-size: 13px; color: #999; }
.compact-value { font-size: 14px; color: #333; font-weight: 500; }

.table-header { display: flex; padding: 3px 0; border-bottom: 1px solid #ebedf0; margin-bottom: 2px; }
.th { font-size: 10px; color: #999; font-weight: 500; }
.th-name { flex: 2; } .th-supplier { flex: 1.5; }
.th-price { flex: 1; text-align: right; } .th-total { flex: 1; text-align: right; }

.table-row { display: flex; align-items: center; padding: 4px 0; border-bottom: 1px solid #f8f8f8; }
.table-row:last-child { border-bottom: none; }
.td { font-size: 12px; color: #333; }
.td-name { flex: 2; font-weight: 500; }
.td-supplier { flex: 1.5; color: #07c160; font-size: 11px; }
.td-price { flex: 1; text-align: right; color: #666; }
.td-total { flex: 1; text-align: right; color: #ee0a24; font-weight: 500; }

.memo-text { font-size: 13px; color: #666; line-height: 1.5; }

/* 编辑模式 */
.edit-row { display: flex; gap: 4px; padding: 4px 0; border-bottom: 1px solid #f8f8f8; }
.edit-input { flex: 1; height: 32px; border: 1px solid #ebedf0; border-radius: 4px; padding: 0 6px; font-size: 12px; text-align: left; }
.edit-name { flex: 2; }
.edit-supplier { flex: 1.5; }
.edit-price { flex: 1; text-align: right; }
.edit-count { flex: 1; text-align: center; }

.action-area { padding: 16px 24px; display: flex; flex-direction: column; gap: 10px; }
.action-area .van-button { border-radius: 8px !important; }
