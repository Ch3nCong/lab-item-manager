<view class="container" wx:if="{{record}}">
  <!-- 状态 -->
  <view class="card">
    <view class="flex-between">
      <van-tag type="{{record.status === 'pending' ? 'warning' : 'primary'}}" size="large">
        {{record.voided ? '已作废' : record.status === 'pending' ? '已申请' : '已确认'}}
      </van-tag>
      <text class="text-secondary" style="font-size:12px;">{{record.create_time}}</text>
    </view>
  </view>

  <!-- 申请信息 -->
  <view class="card">
    <view class="compact-row"><text class="compact-label">申请人</text><text class="compact-value">{{record.applicant || '-'}}</text></view>
    <view class="compact-row"><text class="compact-label">日期</text><text class="compact-value">{{record.apply_date || '-'}}</text></view>
  </view>

  <!-- 物品清单 -->
  <view class="card">
    <view class="card-title">物品清单</view>
    <view class="table-header">
      <text class="th th-name">物品名称</text>
      <text class="th th-supplier">供货商</text>
      <text class="th th-price">单价</text>
      <text class="th th-total">总价</text>
    </view>

    <!-- 查看模式 -->
    <block wx:if="{{!editing}}">
      <view wx:for="{{items}}" wx:key="index" class="table-row">
        <text class="td td-name">{{item.name}}</text>
        <text class="td td-supplier">{{item.supplier || '-'}}</text>
        <text class="td td-price">¥{{item.price}}</text>
        <text class="td td-total">¥{{item.price * item.count}}</text>
      </view>
    </block>

    <!-- 编辑模式 -->
    <block wx:else>
      <view wx:for="{{items}}" wx:key="index" class="edit-row">
        <input class="edit-input edit-name" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onItemEdit" placeholder="物品名" />
        <input class="edit-input edit-supplier" value="{{item.supplier}}" data-index="{{index}}" data-field="supplier" bindinput="onItemEdit" placeholder="供货商" />
        <input class="edit-input edit-price" value="{{item.price}}" type="digit" data-index="{{index}}" data-field="price" bindinput="onItemEdit" placeholder="单价" />
        <input class="edit-input edit-count" value="{{item.count}}" type="number" data-index="{{index}}" data-field="count" bindinput="onItemEdit" placeholder="数量" />
      </view>
    </block>
  </view>

  <!-- 备注 -->
  <view wx:if="{{record.admin_memo}}" class="card">
    <view class="card-title">备注</view>
    <text class="memo-text">{{record.admin_memo}}</text>
  </view>

  <!-- 编辑保存/取消 -->
  <view wx:if="{{editing}}" class="action-area">
    <van-button type="primary" size="large" block bindtap="saveEdit">保存修改</van-button>
    <van-button type="default" size="large" block bindtap="cancelEdit">取消</van-button>
  </view>

  <!-- 正常操作 -->
  <view wx:else class="action-area">
    <van-button wx:if="{{showConfirmBtn}}" type="primary" size="large" block bindtap="handleConfirm">确认</van-button>
    <van-button wx:if="{{showEditBtn}}" type="primary" size="large" block bindtap="handleEdit">编辑申请</van-button>
    <van-button wx:if="{{showVoidBtn}}" type="warning" size="large" block bindtap="handleVoid">作废申请</van-button>
    <van-button wx:if="{{showDeleteBtn}}" type="danger" size="large" block bindtap="handleDelete">删除记录</van-button>
  </view>
</view>
