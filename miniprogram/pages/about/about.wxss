.container { min-height: 100vh; padding: 24px 16px 70px; background: #f5f5f5; }

.logo-area { display: flex; flex-direction: column; align-items: center; padding: 32px 0 24px; background: #fff; border-radius: 10px; margin-bottom: 10px; }
.logo-img { width: 72px; height: 72px; border-radius: 16px; }
.app-name { font-size: 19px; font-weight: 700; color: #333; margin-top: 12px; }
.app-desc { font-size: 12px; color: #999; margin-top: 4px; }
.admin-tip { margin-top: 10px; font-size: 11px; color: #1989fa; background: #e8f4ff; padding: 3px 10px; border-radius: 14px; }

.user-section { background: #fff; border-radius: 10px; padding: 14px; margin-bottom: 10px; }
.user-card { display: flex; align-items: center; }
.avatar { width: 44px; height: 44px; border-radius: 50%; background: #f0f0f0; margin-right: 10px; }
.nickname { font-size: 15px; font-weight: 600; color: #333; }

.action-section { background: #fff; border-radius: 10px; padding: 14px; margin-bottom: 10px; }

.version { text-align: center; font-size: 11px; color: #ccc; margin-top: 30px; }

/* 密码弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; }
.modal-content { width: 280px; background: #fff; border-radius: 12px; padding: 20px 16px 14px; }
.modal-title { font-size: 17px; font-weight: 600; color: #333; text-align: center; margin-bottom: 14px; }
.pwd-input { width: 100%; height: 40px; border: 1px solid #ebedf0; border-radius: 8px; padding: 0 12px; font-size: 15px; text-align: center; letter-spacing: 4px; box-sizing: border-box; }
.pwd-error { text-align: center; font-size: 12px; color: #ee0a24; margin-top: 6px; }
.modal-btns { display: flex; gap: 10px; margin-top: 16px; }
.modal-btn { flex: 1; height: 38px; line-height: 38px; border-radius: 8px; font-size: 14px; text-align: center; border: none; padding: 0; }
.modal-btn::after { border: none; }
.modal-btn-cancel { background: #f5f5f5; color: #666; }
.modal-btn-confirm { background: #1989fa; color: #fff; }
